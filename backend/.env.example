# Referencia: la aplicación lee el entorno; NO carga .env automáticamente.
DANBER_DATABASE_URL=postgresql://danber_api@localhost:26257/danber?sslmode=disable
DANBER_HTTP_ADDR=127.0.0.1:8090
# Autenticación por HTTP desactivada por defecto. Solo pruebas locales en loopback:
DANBER_ALLOW_INSECURE_AUTH=false
DANBER_SESSION_IDLE=15m
DANBER_SESSION_TTL=8h
